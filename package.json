{
  "name": "pasadena-law-review",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "db:seed:content": "tsx --conditions=react-server scripts/seed-content.ts",
    "db:seed:demo": "tsx --conditions=react-server scripts/seed-demo.ts",
    "admin:bootstrap": "tsx --conditions=react-server scripts/bootstrap-admin.ts",
    "jobs:run": "tsx --conditions=react-server scripts/run-jobs.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.9",
    "aws4fetch": "1.0.20",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "server-only": "0.0.1",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "0.2.12",
    "@playwright/test": "1.64.0",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
