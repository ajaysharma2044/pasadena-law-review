# Copy to .env.local for local work. Never commit real values.
# In production (Netlify) set these in Site configuration > Environment variables.

# Public origin of the site, https in production. Netlify also provides URL automatically.
APP_URL=http://localhost:3000

# Postgres connection strings (Neon recommended; see docs/deployment.md). DATABASE_URL is the pooled
# string the app uses; DATABASE_URL_UNPOOLED is the direct one used by migrations and operator scripts.
# Netlify DB's NETLIFY_DATABASE_URL / NETLIFY_DATABASE_URL_UNPOOLED are also accepted.
# Leave all unset locally to use PGlite.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Local only: where PGlite keeps its files when no DATABASE_URL is set.
PGLITE_DIR=.data/pglite

# Session and token signing secret, at least 32 random characters in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Email: "dev" stores messages in the local database (shown at /dev/mailbox); "resend" sends for real.
EMAIL_TRANSPORT=dev
RESEND_API_KEY=
# Signing secret for Resend delivery webhooks (whsec_...), from the Resend dashboard.
RESEND_WEBHOOK_SECRET=
# Verified sender on your own domain, e.g. Pasadena City College Law Journal <editors@your-domain.org>
EMAIL_FROM=
EMAIL_REPLY_TO=

# Private attachment storage: "local" (development, or a single server with a persistent disk),
# "netlify-blobs" (Netlify), or "s3" (any S3-compatible bucket).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/uploads
STORAGE_LOCAL_PERSISTENT=false
NETLIFY_BLOBS_STORE=manuscript-attachments
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Bearer token required by POST /api/jobs/run (email retries). At least 24 random characters.
CRON_SECRET=

# Rate limits on sign-in, sign-up, resend, reset, submissions and uploads. "off" is for automated
# tests only; production refuses it.
RATE_LIMITS=on
# The one header that carries the visitor's IP address, set by your host's proxy. Leave unset on Netlify
# (x-nf-client-connection-ip). Behind another proxy, name its header (e.g. x-real-ip). Any other header
# can be forged by the client, so it's never used.
TRUSTED_IP_HEADER=

# Only for running a production build on local services (end-to-end tests). Shows a warning banner.
PLR_LOCAL_PREVIEW=0
